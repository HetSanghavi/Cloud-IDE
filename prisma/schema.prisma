generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum FileKind {
  FILE
  FOLDER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  image        String?
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id         String     @id @default(cuid())
  shareId    String     @unique @default(cuid())
  name       String
  template   String
  visibility Visibility @default(PRIVATE)
  color      String     @default("violet")
  revision   Int        @default(1)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files      ProjectFile[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([ownerId, updatedAt])
  @@index([visibility, shareId])
}

model ProjectFile {
  id        String    @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  kind      FileKind
  content   String?
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectFile? @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFile[] @relation("FileTree")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, parentId])
  @@unique([projectId, parentId, name])
}
